# 复制为 .env 后按需修改（服务端只读取进程环境变量，不会自动加载 .env，
# 本地开发可用 `dotenv -f .env -- go run ./cmd/api` 或直接 set 环境变量）。

CL_APP_ENV=dev
CL_APP_DEBUG=true

CL_HTTP_ADDR=:8080
CL_HTTP_CORS_ORIGINS=*
CL_HTTP_RATE_LIMIT=600

CL_POSTGRES_HOST=127.0.0.1
CL_POSTGRES_PORT=5432
CL_POSTGRES_USER=postgres
CL_POSTGRES_PASSWORD=postgres
CL_POSTGRES_DATABASE=carnival_landlords
CL_POSTGRES_SSLMODE=disable
CL_POSTGRES_AUTO_MIGRATE=true

CL_REDIS_ADDR=127.0.0.1:6379
CL_REDIS_PASSWORD=
CL_REDIS_DB=0
CL_REDIS_KEY_PREFIX=cl

# 生产必须覆盖：openssl rand -hex 32
CL_JWT_SECRET=carnival-landlords-dev-secret-change-me
CL_JWT_ACCESS_TTL=24h
CL_JWT_REFRESH_TTL=720h

# log 只把验证码打日志；smtp 才真正发信
CL_MAIL_DRIVER=log
CL_MAIL_HOST=
CL_MAIL_PORT=587
CL_MAIL_USER=
CL_MAIL_PASS=
CL_MAIL_FROM=no-reply@carnival-landlords.local

CL_GAME_INITIAL_GOLD=2000
CL_GAME_INITIAL_DIAMONDS=30
CL_GAME_BOT_ENABLED=true

CL_LOG_LEVEL=info
CL_LOG_FORMAT=console
